# Copy to backend/.env (development) or backend/.env.production (deploy/). Never commit real secrets.

ENV=development
# SQLite (default, zero setup) or PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://neet:neet@localhost:5432/neet
DATABASE_URL=sqlite:///./neet_dev.db

# Long random string in production (python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_MINUTES=1440
# true behind HTTPS (required when ENV=production)
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
# Public URL of the web app; used in guardian-consent email links
PUBLIC_APP_URL=http://localhost:3000
# raw source files (PDF/CSV) are kept here by SHA-256
STORAGE_DIR=./storage
# One JSON object per log line (for log collectors)
LOG_JSON=false

# Per-IP requests per minute. Set REDIS_URL so all workers/instances share the counts.
RATE_LIMIT_DEFAULT=240
RATE_LIMIT_AUTH=20
RATE_LIMIT_ASSISTANT=30
REDIS_URL=
# Only behind your own reverse proxy (uses the first X-Forwarded-For address)
TRUST_PROXY_HEADERS=false

# AI assistant (text + voice). Leave the key empty to run the deterministic, tool-only assistant.
# openrouter (default) or anthropic
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Fast, cheap and strong at tool calling. Fallbacks are tried if it is unavailable.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_FALLBACK_MODELS=["google/gemini-2.5-flash-lite","openai/gpt-4.1-nano"]

# Practice question bank (uses OPENROUTER_API_KEY). Students never see a question twice; when their pool of
# unseen questions runs low, new ones are written and kept only if a second model gets the same answer.
QUESTION_GEN_ENABLED=true
QUESTION_WRITER_MODEL=anthropic/claude-haiku-5.5
QUESTION_CHECKER_MODEL=deepseek/deepseek-v4-flash
QUESTION_GEN_WORKERS=6
UNSEEN_BUFFER_PER_SECTION=60
# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Semantic search (Voyage AI embeddings). Empty key = keyword (BM25) search only.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5

# OCR for scanned PDFs (needs the tesseract binary; the Docker image has it)
OCR_ENABLED=true
TESSERACT_CMD=
OCR_LANGUAGES=eng

# Nearby places: none | overpass (OpenStreetMap; set a real contact in the user agent)
PLACES_PROVIDER=none
OVERPASS_URL=https://overpass-api.de/api/interpreter
PLACES_USER_AGENT=NEETCompass/0.2 (contact: you@example.org)

# Email for guardian-consent links: console (logs + storage/outbox) | smtp
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Privacy
PRIVACY_NOTICE_VERSION=2026-10-draft
GUARDIAN_LINK_HOURS=72
UNCONSENTED_MINOR_RETENTION_DAYS=7
# Reference to the completed DPDP legal review (memo/ticket id). Empty = not done.
DPDP_REVIEW_REFERENCE=

PREDICTOR_YEARS_CONSIDERED=3

# Password for the seeded demo accounts admin@demo.test / student@demo.test (dev only)
SEED_DEMO_PASSWORD=demo-password-123
